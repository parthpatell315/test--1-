{
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:api": "jest tests/api",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test:unit && npm run test:api && npm run test:e2e",
    "vercel-build": "cd frontend && npm install && npm run build && cd .. && node -e \"const fs = require('fs'); fs.rmSync('.next', {recursive: true, force: true}); fs.cpSync('frontend/.next', '.next', {recursive: true});\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/client": "^7.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.0",
    "bcryptjs": "^3.0.3",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "next": "16.2.4",
    "pdfjs-dist": "^6.1.200",
    "postcss": "^8.4.49",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-medium-image-zoom": "^5.4.8",
    "react-pdf": "^10.4.1",
